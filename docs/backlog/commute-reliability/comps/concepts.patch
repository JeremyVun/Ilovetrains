diff --git a/web/app.css b/web/app.css
index 2675bdd..4b338b0 100644
--- a/web/app.css
+++ b/web/app.css
@@ -965,3 +965,85 @@ html[data-theme="dark"] .tiny-train-headlight { fill: #FFF1AE; }
 @media (prefers-reduced-motion: reduce) {
   .tiny-train-consist { will-change: auto; }
 }
+
+/* ---- COMP ROUND 2 Stop trip (throwaway) --------------------------------- */
+.sx-stop {
+  display: flex; align-items: center; gap: 9px; white-space: nowrap;
+  font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--ink);
+}
+.sx-stop-icon { width: 11px; height: 11px; flex: none; fill: currentColor; color: var(--ink-2); }
+
+/* D: the bar's third slot. Equal grow keeps the visual gaps equal and the hit
+   areas tiling the whole bar. */
+.hm-bar.sx-three button { flex: 1 1 auto; min-width: 0; }
+.hm-bar.sx-three button:nth-child(2) { justify-content: center; }
+.hm-bar.sx-three button:last-child { justify-content: flex-end; }
+
+/* E: beside CHANGE, the offer pair's quiet action (hm-acts .q) in readable ink.
+   22px is the widest pair gap the 375 track allows (hm-acts uses 26); the
+   hairline keeps STOP TRIP CHANGE from reading as one phrase (pass 2). */
+.hm-strip .sx-strip-stop, .hm-rec-strip .sx-strip-stop { margin-left: auto; color: var(--ink-2); }
+.sx-div { flex: none; width: 1px; height: 14px; margin: 0 -3.5px; background: var(--rule-2); }
+
+/* F: under the destination's arrival clock, on the figure label's baseline.
+   Full ink: in this header 12px/600 caps in --ink-2 read as a label (pass 2). */
+.hm-e.to .sx-dest-stop {
+  align-self: flex-end; height: 44px; margin: -3px 0 -21px; padding-left: 12px;
+  color: var(--ink);
+}
+
+/* A2 with the receipt fix: the correction follows the receipt. */
+.hm-rec + .hm-rec-strip { grid-row: 5; margin-top: 4px; }
+
+/* ---- COMP ROUND 3 trip-control line (throwaway) -------------------------- */
+/* The strip's own box (48px + hairline, 22/18px sides) for every state. The
+   question may wrap inside the 48px; it never ellipsises. */
+.hm-strip.tl { justify-content: flex-start; }
+.hm-strip.tl .q {
+  flex: 0 1 auto; white-space: normal; overflow: visible; text-overflow: clip; line-height: 1.25;
+}
+.hm-strip.tl .tl-rule { flex: none; align-self: stretch; width: 1px; background: var(--rule); }
+/* A lone action owns the whole line, as the journey rail's does. */
+.hm-strip.tl-started .tl-act, .hm-strip.tl-startable:not(.tl-e1) .tl-act { flex: 1 1 auto; text-align: left; }
+
+/* E1: the switch keeps a cell of its own at the line's end, behind a column
+   rule, in every state; whatever the app asks sits to its left. The whole
+   cell, out to the screen edge, is the switch's target. */
+.hm-strip.tl-e1 .tl-rule { margin-left: auto; margin-right: -14px; }
+.hm-strip.tl-e1 .tl-act { flex: none; padding: 0 22px 0 14px; margin-right: -22px; }
+@media (max-width: 375px) { .hm-strip.tl-e1 .tl-act { padding-right: 18px; margin-right: -18px; } }
+.hm-strip.tl.tl-v-b .q { text-wrap: balance; }
+
+/* E2: the switch at the left in every state; the question and its answer at
+   the right, as today's strip. */
+.hm-strip.tl-e2 .tl-rule { display: none; }
+.hm-strip.tl-e2 .tl-pair { margin-left: auto; display: flex; align-items: center; gap: 14px; min-width: 0; }
+/* A wrapped question stays against its answer. */
+.hm-strip.tl-e2 .tl-pair .q { text-align: right; }
+
+/* E3: two plain verbs at the two ends, as the bar. */
+.hm-strip.tl-e3 .tl-change { margin-left: auto; }
+
+/* The bar's glyph idiom on the switch (E3; pass variant g elsewhere): a stop
+   square and a start triangle at the caps' height, in the + glyph's ink. */
+.hm-strip.tl .tl-act:has(.tl-g) { display: flex; align-items: center; gap: 9px; }
+.hm-strip.tl .tl-g { width: 11px; height: 11px; flex: none; fill: currentColor; color: var(--ink-2); }
+/* E2, E3: the switch at the line's start takes the margin out to the screen edge. */
+.hm-strip.tl-e2 .tl-act, .hm-strip.tl-e3 .tl-act { margin-left: -22px; padding-left: 22px; }
+@media (max-width: 375px) { .hm-strip.tl-e2 .tl-act, .hm-strip.tl-e3 .tl-act { margin-left: -18px; padding-left: 18px; } }
+
+/* ---- COMP ROUND 3b synthesis (throwaway) ---------------------------------- */
+/* Guessed: round 2's E. One px from the question's gap lets it print whole in
+   Roboto at 360; wider, the auto margin before STOP TRIP absorbs it. */
+.hm-strip.r3b-guessed .q { margin-right: -1px; }
+/* Started and startable: E3's glyph on the action, in the bar's glyph ink,
+   centred on the caps rather than the line box (Roboto's caps sit 0.75px
+   above its line box's centre). */
+.hm-strip.r3b .r3b-act { display: flex; align-items: center; }
+.hm-strip.r3b .r3b-in { display: block; }
+.hm-strip.r3b .r3b-g {
+  display: inline-block; vertical-align: baseline; position: relative; top: calc(5.5px - .5cap);
+  width: 11px; height: 11px; margin-right: 9px; fill: currentColor; color: var(--ink-2);
+}
+.hm-strip.r3b-started.r3b-right { justify-content: flex-end; }
+.hm-strip.r3b-started.r3b-left { justify-content: flex-start; }
