+  const PLAY = '<svg class="tl-g" aria-hidden="true" viewBox="0 0 12 12"><path d="M2.5 1.2 11 6 2.5 10.8z"/></svg>';
+  const stop = `<button class="tl-act tl-stop" data-act="stop-trip" data-stop-trip data-tap>${glyph ? STOP_SQ : ''}Stop trip</button>`;
+  const start = `<button class="tl-act tl-start" data-act="start-trip" data-start-trip data-tap>${glyph ? PLAY : ''}Start trip</button>`;
+  const change = (label) => `<button class="tl-change" data-act="change-destination" data-tap>${label}</button>`;
+  const rule = '<i class="tl-rule" aria-hidden="true"></i>';
+  const open = (kind) => `<div class="hm-strip tl tl-${COMP} tl-${kind}${COMP_V ? ` tl-v-${COMP_V}` : ''}" data-tripline="${kind}"${kind === 'guessed' ? ' data-strip' : ''}>`;
+  const lone = (button) => `${open(line.kind)}${button}</div>`;
+  if (COMP === 'e1') {
+    if (line.kind === 'guessed') return `${open('guessed')}${q('Going somewhere else?')}${change('Change')}${rule}${stop}</div>`;
+    if (line.kind === 'started') return `${open('started')}${rule}${stop}</div>`;
+    // Names the train it starts, in the instruction's own grammar ("Board the 10:08 at …").
+    return `${open('startable')}${q(`Taking the ${line.depTime}?`)}${rule}${start}</div>`;
+  }
+  if (COMP === 'e2') {
